# CivicEye — copy to .env and fill in values from your Supabase project dashboard.
# Never commit .env or real keys to git.

# Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=

# Supabase anon/public key (Settings → API → anon public)
# Safe to expose in the browser; access is enforced by Row Level Security.
# Lovable-linked projects may use VITE_SUPABASE_PUBLISHABLE_KEY instead — both work.
VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional — Lovable may set this instead of VITE_SUPABASE_URL
# VITE_SUPABASE_PROJECT_ID=

# Organization UUID for public citizen reports (create via docs/SUPABASE_SETUP.md)
# Required when Supabase is enabled.
VITE_DEFAULT_ORGANIZATION_ID=

# Optional map tile provider (defaults to OpenStreetMap public tiles)
# For production, use a tile provider that permits your traffic volume.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Billing (Phase 5) — none | manual | stripe. Checkout requires server-side integration.
# VITE_BILLING_PROVIDER=none
# VITE_BILLING_CHECKOUT_ENABLED=false
