# CivicEye environment variables
# Copy this file to .env (local) or set these in your host's dashboard.
# NEVER commit real credentials to version control.

# ---------------------------------------------------------------------------
# Public / browser-safe configuration (VITE_* is inlined into the client bundle)
# ---------------------------------------------------------------------------

# Supabase project URL (required for report submission, staff features, org teams)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon / publishable key (required).
# Use VITE_SUPABASE_ANON_KEY or VITE_SUPABASE_PUBLISHABLE_KEY — both work.
# This key is public by design and is safe in the browser. RLS is the real
# access control layer.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Default organization UUID used to route public citizen reports (required for
# anonymous reporting). Staff always use the organization on their own profile.
VITE_DEFAULT_ORGANIZATION_ID=your-organization-id

# Optional map tiles. Leave unset to use the default OpenStreetMap tiles.
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors

# ---------------------------------------------------------------------------
# SERVER-ONLY secrets — read in the server function, never sent to the browser
# ---------------------------------------------------------------------------
# Add these to your deployment environment. Do NOT prefix them with VITE_.
# With none of them set, the AI assistant runs on a built-in product knowledge
# base and labels itself honestly in the UI.

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# GROQ_API_KEY=gsk_...

# Optional: override the model used by whichever provider is configured.
# CIVICEYE_AI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
